{
    "name": "おお！こんなところにボタンが！",
    "description": "好きなサイトの好きな位置にボタンを配置できる拡張機能",
    "manifest_version": 3,
    "version": "1.0.0",
    "permissions": ["storage", "contextMenus", "activeTab"],
    "host_permissions": ["http://*/*", "https://*/*"],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts":[
        {
            "matches":[
                "<all_urls>"
            ],
            "js":[
                "content.js"
            ]
        }
    ]
}